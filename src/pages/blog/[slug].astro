---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { SITE } from '../../data/site';
import { getPosts, breadcrumbs, orgLd } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const url = `${SITE.url}/blog/${post.id}`;
const published = post.data.pubDate.toISOString();
const modified = (post.data.updatedDate ?? post.data.pubDate).toISOString();
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    url,
    mainEntityOfPage: url,
    datePublished: published,
    dateModified: modified,
    inLanguage: 'en-US',
    image: `${SITE.url}/og.png`,
    author: orgLd,
    publisher: orgLd,
    isPartOf: { '@id': `${SITE.url}/blog#blog` },
  },
  breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, { name: post.data.title, path: `/blog/${post.id}` }]),
];
---
<Base title={post.data.title} description={post.data.description} type="article" publishedTime={published} jsonLd={jsonLd}>
  <article>
    <nav aria-label="Breadcrumb" class="meta"><a href="/blog">← Blog</a></nav>
    <h1>{post.data.title}</h1>
    <p class="meta">By {SITE.name} · <time datetime={published}>{fmt(post.data.pubDate)}</time></p>
    <div class="prose"><Content /></div>
  </article>
</Base>
